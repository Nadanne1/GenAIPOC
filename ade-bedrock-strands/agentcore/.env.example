# AWS Configuration
AWS_REGION=us-west-2
AWS_ACCOUNT_ID=123456789012

# AWS Credentials (configure via AWS CLI or environment variables)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# ECR Configuration
ECR_REPO_NAME=financial-analyst-agent
ECR_REPO_URI=${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com/${ECR_REPO_NAME}
ECR_IMAGE_URI=${ECR_REPO_URI}:latest

# Bedrock Configuration
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-20250514-v1:0
BEDROCK_KB_ID=YOUR_KNOWLEDGE_BASE_ID
BEDROCK_DATA_SOURCE_ID=YOUR_DATA_SOURCE_ID

# Agent Role (will be created by create_correct_role.py)
AGENT_ROLE_ARN=arn:aws:iam::${AWS_ACCOUNT_ID}:role/FinancialAnalystAgentCoreRole
