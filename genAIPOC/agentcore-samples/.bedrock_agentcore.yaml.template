default_agent: llamaindex_rag_agent_workflow
agents:
  llamaindex_rag_agent_workflow:
    name: llamaindex_rag_agent_workflow
    entrypoint: agentcore_runtime/agentcore_entry_workflow.py
    platform: linux/arm64
    container_runtime: none
    aws:
      execution_role_auto_create: true
      account: YOUR_AWS_ACCOUNT_ID
      region: us-east-1
      ecr_auto_create: true
      network_configuration:
        network_mode: PUBLIC
      protocol_configuration:
        server_protocol: HTTP
      observability:
        enabled: true
    bedrock_agentcore:
      agent_id: null
      agent_arn: null
      agent_session_id: null
    codebuild:
      project_name: null
      execution_role: null
      source_bucket: null
