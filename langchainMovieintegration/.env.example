# AWS Configuration
AWS_REGION=us-west-2

# Option 1: Use Bedrock Bearer Token (recommended)
AWS_BEARER_TOKEN_BEDROCK=your_bearer_token_here

# Option 2: Use standard AWS credentials (comment out if using bearer token)
# AWS_ACCESS_KEY_ID=your_access_key_here
# AWS_SECRET_ACCESS_KEY=your_secret_key_here
# AWS_SESSION_TOKEN=your_session_token_here (only for temporary credentials)

# OMDB API Configuration (for movie data)
OMDB_API_KEY=your_omdb_api_key_here

# LangSmith Configuration (optional but recommended for tracing)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=movie-assistant-multiagent
