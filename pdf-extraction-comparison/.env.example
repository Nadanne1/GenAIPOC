# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
# AWS_SESSION_TOKEN=your_session_token_here  # Optional, for temporary credentials

# Bedrock Data Automation Configuration
BDA_PROJECT_ARN=arn:aws:bedrock:REGION:ACCOUNT_ID:data-automation-project/PROJECT_ID
BDA_TEMP_BUCKET=your-s3-bucket-name
OUTPUT_BUCKET=your-output-bucket-name

# Optional: If using specific profiles
# AWS_PROFILE=your_profile_name
